{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@anc/shared": ["../../packages/shared/dist/index.d.ts", "../../packages/shared/src/index.ts"],
      "@anc/shared/*": ["../../packages/shared/dist/*", "../../packages/shared/src/*"]
    },
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
